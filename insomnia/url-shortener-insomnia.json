    {
      "_id": "req_redirect_valid",
      "parentId": "fld_redirect_tests",
      "modified": 1791892800000,
      "created": 1791892800000,
      "url": "http://localhost:8080/{shortCode}",
      "name": "01 - Redirecionar código existente (espera 302)",
      "description": "Substitua {shortCode} pelo código de uma URL já cadastrada antes de enviar a requisição.",
      "method": "GET",
      "body": {},
      "parameters": [],
      "headers": [],
      "authentication": {},
      "scripts": {
        "afterResponse": "const location = insomnia.response.headers.find(\n  (header) => header.key.toLowerCase() === 'location'\n);\n\ninsomnia.test('responde HTTP 302', () => {\n  insomnia.expect(insomnia.response.code).to.eql(302);\n});\n\ninsomnia.test('informa a URL original no cabeçalho Location', () => {\n  insomnia.expect(location, 'cabeçalho Location').to.exist;\n  insomnia.expect(location.value).to.eql('https://example.com/minha-pagina');\n});"
      },
      "settings": {
        "renderRequestBody": true,
        "encodeUrl": true,
        "rebuildPath": true,
        "followRedirects": false,
        "cookies": {
          "send": true,
          "store": true
        }
      },
