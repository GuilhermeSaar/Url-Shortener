      "parentId": "fld_stats_tests",
      "modified": 1791892800000,
      "created": 1791892800000,
      "url": "http://localhost:8080/api/url/COLE_O_CODIGO_GERADO",
      "name": "02 - Consultar estatísticas com JWT (espera 200)",
      "description": "Execute POST /shorten e depois Login válido. Cole o código retornado na URL e o token do login no cabeçalho Authorization.",
      "method": "GET",
      "body": {},
      "parameters": [],
      "headers": [
        {
          "name": "Accept",
          "value": "application/json"
        },
        {
          "name": "Authorization",
          "value": "Bearer COLE_O_TOKEN_DO_LOGIN_AQUI"
        }
      ],
      "authentication": {},
      "scripts": {
        "afterResponse": "const body = JSON.parse(insomnia.response.text());\n\ninsomnia.test('responde HTTP 200', () => {\n  insomnia.expect(insomnia.response.code).to.eql(200);\n});\n\ninsomnia.test('retorna os campos de estatísticas da URL', () => {\n  insomnia.expect(body).to.have.all.keys('date', 'clickCount', 'urlOriginal');\n  insomnia.expect(body.date).to.be.a('string');\n  insomnia.expect(body.date).to.include('T');\n  insomnia.expect(body.clickCount).to.be.a('number');\n  insomnia.expect(body.clickCount).to.be.at.least(0);\n  insomnia.expect(body.urlOriginal).to.eql('https://example.com/minha-pagina');\n});"
      },
      "settings": {
        "renderRequestBody": true,
        "encodeUrl": true,
        "rebuildPath": true,
        "followRedirects": false,
        "cookies": {
