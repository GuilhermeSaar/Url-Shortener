    {
      "_id": "req_shorten_valid",
      "parentId": "fld_shorten_tests",
      "modified": 1791892800000,
      "created": 1791892800000,
      "url": "http://localhost:8080/shorten",
      "name": "01 - Encurtar URL válida (espera 201 e URL curta)",
      "description": "Envia uma URL HTTPS e valida a URL curta retornada.",
      "method": "POST",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"url\": \"https://example.com/minha-pagina\"\n}"
      },
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "Accept",
          "value": "text/plain"
        }
      ],
      "authentication": {},
      "scripts": {
        "afterResponse": "const shortUrl = insomnia.response.text().trim();\n\ninsomnia.test('responde HTTP 201', () => {\n  insomnia.expect(insomnia.response.code).to.eql(201);\n});\n\ninsomnia.test('retorna URL curta com código Base62 de 6 caracteres', () => {\n  insomnia.expect(shortUrl).to.match(/^https?:\\/\\/[^/]+\\/[a-zA-Z0-9]{6}$/);\n});"
      },
      "settings": {
        "renderRequestBody": true,
        "encodeUrl": true,
        "rebuildPath": true,
        "followRedirects": true,
        "cookies": {
          "send": true,
          "store": true
        }
      },
      "_type": "request"
    },
