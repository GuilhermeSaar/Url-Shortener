    {
      "_id": "req_shorten_valid",
      "parentId": "fld_shorten_tests",
      "modified": 1791892800000,
      "created": 1791892800000,
      "url": "http://localhost:8080/urls/shorten",
      "name": "01 - Encurtar URL válida (espera 200 e código de 6 caracteres)",
      "description": "Envia uma URL HTTPS e valida o status e o formato do código retornado em texto puro.",
      "method": "POST",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"url\": \"https://example.com/minha-pagina\"\n}"
      },
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "Accept",
          "value": "text/plain"
        }
      ],
      "authentication": {},
      "scripts": {
        "afterResponse": "insomnia.test('responde HTTP 200', () => {\n  insomnia.expect(insomnia.response.code).to.eql(200);\n});\n\ninsomnia.test('retorna código Base62 com exatamente 6 caracteres', () => {\n  insomnia.expect(insomnia.response.text().trim()).to.match(/^[a-zA-Z0-9]{6}$/);\n});"
      },
      "settings": {
        "renderRequestBody": true,
        "encodeUrl": true,
        "rebuildPath": true,
        "followRedirects": true,
        "cookies": {
          "send": true,
          "store": true
        }
      },
      "_type": "request"
    },
