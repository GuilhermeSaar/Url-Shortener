# Copie para .env. O Spring Boot e o Docker Compose leem estas variáveis.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/url_shortener
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# Gere uma chave com: openssl rand -base64 48
JWT_SECRET=COLE_UMA_CHAVE_BASE64_COM_PELO_MENOS_32_BYTES_AQUI
JWT_EXPIRATION_MS=3600000
